{
    "type": "origins:multiple",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/active.png",
            "text": {
                "translate": "origins.gui.badge.active",
                "with": [
                    {
                        "keybind": "key.raven_dnd_origins.cantrip_three"
                    }
                ]
            }
        }
    ],
    "invoke": {
        "type": "origins:active_self",
        "key": {
            "key": "key.raven_dnd_origins.cantrip_three"
        },
        "cooldown": 24000,
        "condition": {
            "type": "raven_dnd_origins:player_level",
            "comparison": ">=",
            "compare_to": 10
        },
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:or",
                "conditions": [
                    {
                        "type": "raven_dnd_origins:player_level",
                        "comparison": ">=",
                        "compare_to": 20
                    },
                    {
                        "type": "raven_dnd_origins:leveled_chance",
                        "base": 0,
                        "per_level": 0.02,
                        "aptitude": "justlevelingfork:luck"
                    }
                ]
            },
            "if_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:area_of_effect",
                        "radius": 16,
                        "include_actor": true,
                        "bientity_condition": {
                            "type": "origins:or",
                            "conditions": [
                                {
                                    "type": "raven_dnd_origins:allied"
                                },
                                {
                                    "type": "origins:target_condition",
                                    "condition": {
                                        "type": "raven_dnd_origins:is_friendly"
                                    }
                                }
                            ]
                        },
                        "bientity_action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "raven_dnd_origins:restore_mana",
                                        "amount": 100000
                                    }
                                },
                                {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "raven_dnd_origins:reset_spell_cooldowns"
                                    }
                                },
                                {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "origins:apply_effect",
                                        "effect": {
                                            "effect": "apothic_attributes:knowledge",
                                            "duration": 600,
                                            "amplifier": 3,
                                            "is_ambient": false,
                                            "show_particles": true,
                                            "show_icon": true
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "type": "raven_dnd_origins:action_bar_message",
                        "message": {
                            "translate": "raven_dnd_origins.divine_intervention.success",
                            "color": "green",
                            "with": [
                                {
                                    "translate": "raven_dnd_origins.divine_intervention.deity.athena"
                                }
                            ]
                        }
                    }
                ]
            },
            "else_action": {
                "type": "raven_dnd_origins:action_bar_message",
                "message": {
                    "translate": "raven_dnd_origins.divine_intervention.fail",
                    "color": "red"
                }
            }
        },
        "hud_render": {
            "should_render": true,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_invoke",
                "compare_to": 0,
                "comparison": ">"
            },
            "sprite_location": "raven_dnd_origins:textures/gui/resource_bar/spiderkolo_02.png",
            "bar_index": 9
        }
    },
    "sleep": {
        "type": "origins:action_on_wake_up",
        "entity_action": {
            "type": "origins:modify_resource",
            "resource": "*:*_invoke",
            "modifier": {
                "operation": "set_total",
                "value": 0
            }
        }
    }
}
