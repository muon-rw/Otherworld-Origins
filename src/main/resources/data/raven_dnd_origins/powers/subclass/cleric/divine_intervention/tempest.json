{
    "type": "origins:multiple",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/active.png",
            "text": {
                "translate": "origins.gui.badge.active",
                "with": [
                    {
                        "keybind": "key.raven_dnd_origins.cantrip_three"
                    }
                ]
            }
        }
    ],
    "invoke": {
        "type": "origins:active_self",
        "key": {
            "key": "key.raven_dnd_origins.cantrip_three"
        },
        "cooldown": 24000,
        "condition": {
            "type": "raven_dnd_origins:player_level",
            "comparison": ">=",
            "compare_to": 10
        },
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:or",
                "conditions": [
                    {
                        "type": "raven_dnd_origins:player_level",
                        "comparison": ">=",
                        "compare_to": 20
                    },
                    {
                        "type": "raven_dnd_origins:leveled_chance",
                        "base": 0,
                        "per_level": 0.02,
                        "aptitude": "justlevelingfork:luck"
                    }
                ]
            },
            "if_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "raven_dnd_origins:cast_spell",
                        "spell": "irons_spellbooks:shockwave",
                        "power_level": 5,
                        "cast_time": 0,
                        "interrupt_mode": "force_complete"
                    },
                    {
                        "type": "origins:delay",
                        "ticks": 5,
                        "action": {
                            "type": "raven_dnd_origins:cast_spell",
                            "spell": "irons_spellbooks:ascension",
                            "power_level": 5,
                            "cast_time": 0,
                            "interrupt_mode": "force_complete"
                        }
                    },
                    {
                        "type": "origins:delay",
                        "ticks": 10,
                        "action": {
                            "type": "raven_dnd_origins:cast_spell",
                            "spell": "irons_spellbooks:thunderstorm",
                            "power_level": 5,
                            "cast_time": 0,
                            "interrupt_mode": "force_complete"
                        }
                    },
                    {
                        "type": "raven_dnd_origins:area_of_effect_sequential",
                        "radius": 16,
                        "include_actor": false,
                        "application_count": 20,
                        "delay_ticks": 3,
                        "bientity_condition": {
                            "type": "origins:or",
                            "inverted": true,
                            "conditions": [
                                {
                                    "type": "raven_dnd_origins:allied"
                                },
                                {
                                    "type": "origins:target_condition",
                                    "condition": {
                                        "type": "raven_dnd_origins:is_friendly"
                                    }
                                }
                            ]
                        },
                        "bientity_action": {
                            "type": "raven_dnd_origins:cast_spell",
                            "spell": "irons_spellbooks:lightning_lance",
                            "power_level": 5,
                            "cast_time": 0,
                            "interrupt_mode": "force_complete"
                        }
                    },
                    {
                        "type": "raven_dnd_origins:action_bar_message",
                        "message": {
                            "translate": "raven_dnd_origins.divine_intervention.success",
                            "color": "green",
                            "with": [
                                {
                                    "translate": "raven_dnd_origins.divine_intervention.deity.zeus"
                                }
                            ]
                        }
                    }
                ]
            },
            "else_action": {
                "type": "raven_dnd_origins:action_bar_message",
                "message": {
                    "translate": "raven_dnd_origins.divine_intervention.fail",
                    "color": "red"
                }
            }
        },
        "hud_render": {
            "should_render": true,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_invoke",
                "compare_to": 0,
                "comparison": ">"
            },
            "sprite_location": "raven_dnd_origins:textures/gui/resource_bar/spiderkolo_02.png",
            "bar_index": 9
        }
    },
    "sleep": {
        "type": "origins:action_on_wake_up",
        "entity_action": {
            "type": "origins:modify_resource",
            "resource": "*:*_invoke",
            "modifier": {
                "operation": "set_total",
                "value": 0
            }
        }
    }
}